+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn responses_mode_stream_cli_disables_openai_websockets_from_config_file() {
+    skip_if_no_network!();
+
+    let server = MockServer::start().await;
+    let resp_mock = responses::mount_sse_once(&server, cli_sse_response()).await;
+    let home = TempDir::new().unwrap();
+    let base_url = format!("{}/v1", server.uri());
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            "openai_base_url = '{base_url}'\n\
+             openai_supports_websockets = false\n\
+             openai_websocket_connect_timeout_ms = 5000\n"
+        ),
+    )
+    .unwrap();
+
+    let bin = codex_utils_cargo_bin::cargo_bin("codex").unwrap();
+    let mut cmd = Command::new(bin);
+    cmd.arg("exec")
+        .arg("--skip-git-repo-check")
+        .arg("-C")
+        .arg(repo_root())
+        .arg("hello?");
+    cmd.env("CODEX_HOME", home.path())
+        .env("OPENAI_API_KEY", "dummy")
+        .env(CODEX_API_KEY_ENV_VAR, "dummy")
+        .env_remove(CODEX_ACCESS_TOKEN_ENV_VAR);
+
+    let output = run_cli_command(&mut cmd).unwrap();
+    assert!(
+        output.status.success(),
+        "codex exec failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(resp_mock.single_request().path(), "/v1/responses");
+    let websocket_upgrades = server
+        .received_requests()
+        .await
+        .unwrap()
+        .into_iter()
+        .filter(|request| request.headers.contains_key("upgrade"))
+        .count();
+    assert_eq!(websocket_upgrades, 0);
+}
