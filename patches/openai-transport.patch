+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn openai_transport_connect_timeout_from_config_file() {
+    skip_if_no_network!();
+
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let codex_home = TempDir::new().unwrap();
+    std::fs::write(
+        codex_home.path().join("config.toml"),
+        format!(
+            "openai_base_url = 'http://{address}/v1'\n\
+             openai_websocket_connect_timeout_ms = 100"
+        ),
+    )
+    .unwrap();
+    let config = codex_core::config::ConfigBuilder::default()
+        .codex_home(codex_home.path().to_path_buf())
+        .fallback_cwd(Some(codex_home.path().to_path_buf()))
+        .loader_overrides(codex_config::LoaderOverrides::without_managed_config_for_tests())
+        .build()
+        .await
+        .unwrap();
+    let harness = websocket_harness_with_provider_options_and_auth(
+        config.model_provider,
+        /*runtime_metrics_enabled*/ false,
+        /*concurrent_reasoning_summaries_enabled*/ false,
+        /*enabled_features*/ &[],
+        Some(CodexAuth::from_api_key("test-key")),
+    )
+    .await;
+    let mut session = harness.client.new_session();
+    let metadata = websocket_connection_metadata(&harness);
+    // Keep the accepted socket open without completing the WebSocket handshake.
+    let started = tokio::time::Instant::now();
+    let (result, accepted) = tokio::time::timeout(Duration::from_secs(5), async {
+        tokio::join!(
+            session.preconnect_websocket(
+                &harness.model_info,
+                &harness.session_telemetry,
+                &metadata
+            ),
+            listener.accept(),
+        )
+    })
+    .await
+    .expect("configured handshake timeout should expire within five seconds");
+    let (_socket, _) = accepted.unwrap();
+    assert!(matches!(
+        result,
+        Err(codex_api::ApiError::Transport(
+            codex_api::TransportError::Timeout
+        ))
+    ));
+    assert!(started.elapsed() >= Duration::from_millis(100));
+}
