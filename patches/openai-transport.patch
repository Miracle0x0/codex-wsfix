+use super::ConfigBuilder;
+use codex_config::LoaderOverrides;
+use codex_config::config_toml::ConfigToml;
+use codex_model_provider_info::ModelProviderInfo;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+#[tokio::test]
+async fn openai_transport_overrides_preserve_other_provider_fields() -> anyhow::Result<()> {
+    for (settings, websocket_override, timeout_override) in [
+        ("", None, None),
+        ("openai_supports_websockets = false", Some(false), None),
+        ("openai_supports_websockets = true", Some(true), None),
+        (
+            "openai_websocket_connect_timeout_ms = 5000",
+            None,
+            Some(5000),
+        ),
+        ("openai_websocket_connect_timeout_ms = 0", None, Some(0)),
+        (
+            "openai_supports_websockets = true\nopenai_websocket_connect_timeout_ms = 9000",
+            Some(true),
+            Some(9000),
+        ),
+        (
+            "openai_supports_websockets = false\nopenai_websocket_connect_timeout_ms = 7000",
+            Some(false),
+            Some(7000),
+        ),
+    ] {
+        let codex_home = TempDir::new()?;
+        let base_url = "https://openai.example.test/v1";
+        std::fs::write(
+            codex_home.path().join("config.toml"),
+            format!("openai_base_url = '{base_url}'\n{settings}"),
+        )?;
+        let config = ConfigBuilder::default()
+            .codex_home(codex_home.path().to_path_buf())
+            .fallback_cwd(Some(codex_home.path().to_path_buf()))
+            .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+            .build()
+            .await?;
+        let mut expected = ModelProviderInfo::create_openai_provider(Some(base_url.to_string()));
+        if let Some(enabled) = websocket_override {
+            expected.supports_websockets = enabled;
+        }
+        if let Some(timeout_ms) = timeout_override {
+            expected.websocket_connect_timeout_ms = Some(timeout_ms);
+        }
+
+        assert_eq!(config.model_provider_id, "openai");
+        assert_eq!(config.model_provider, expected);
+        assert_eq!(config.model_providers["openai"], expected);
+        if let Some(timeout_ms) = timeout_override {
+            assert_eq!(
+                config.model_provider.websocket_connect_timeout(),
+                std::time::Duration::from_millis(timeout_ms),
+            );
+        }
+    }
+    Ok(())
+}
