+
+        let listener = TcpListener::bind("127.0.0.1:0")
+            .await
+            .expect("bind loopback listener");
+        let addr = listener.local_addr().expect("read local addr");
+
+        // Server side: accept one connection and report whether it ever receives a
+        // client-initiated ping frame.
+        let server = tokio::spawn(async move {
+            let (tcp, _) = listener.accept().await.expect("accept connection");
+            let mut server_ws = accept_async(tcp).await.expect("server handshake");
+            loop {
+                match server_ws.next().await {
+                    Some(Ok(Message::Ping(_))) => return true,
+                    Some(Ok(_)) => continue,
+                    Some(Err(_)) | None => return false,
+                }
+            }
+        });
